# ==============================================================================
# MOBEX Automotive Platform — Production Environment Configuration (.env)
# ==============================================================================
# NOTE: ค่าเหล่านี้คือการตั้งค่าระดับโครงสร้างพื้นฐาน (Infrastructure & Secrets)
# ไม่ควรใส่ในเมนู Setting หลังบ้าน เพื่อป้องกันการรั่วไหลของรหัสผ่านและความปลอดภัย
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# จำกัด Memory ของ Node.js ไม่ให้กิน RAM เกิน 512MB (เหมาะสำหรับ Server ขนาดเล็ก-กลาง)
NODE_OPTIONS="--max-old-space-size=512"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
# connection_limit: จำกัด Pool การเชื่อมต่อ (แนะนำ 5 - 10 สำหรับ Single Node)
# pool_timeout: วินาทีที่รอก่อน Timeout เมื่อ Pool เต็ม
# connect_timeout: วินาทีที่รอการเชื่อมต่อฐานข้อมูล
DATABASE_URL="postgresql://autoparts_user:autoparts_secure_pass123@127.0.0.1:5432/car_parts_catalog?schema=public&connection_limit=8&pool_timeout=15&connect_timeout=10"
# TEST_DATABASE_URL="postgresql://autoparts_user:autoparts_secure_pass123@127.0.0.1:5432/car_parts_catalog_test?schema=public"

# ------------------------------------------------------------------------------
# 3. SECURITY & CRYPTOGRAPHIC SECRETS (ห้ามเปิดเผยเด็ดขาด)
# ------------------------------------------------------------------------------
# คีย์สำหรับเข้ารหัส HMAC และ Sign Session Cookie / Password Reset Token (อย่างน้อย 32 ตัวอักษร)
SESSION_COOKIE_SECRET="super-secret-cookie-signing-key-minimum-32-chars-mobex"
SESSION_COOKIE_NAME="autoparts_session"
SESSION_TTL_HOURS=168

# กุญแจ Master Bypass Key สำหรับ System / Webhook ภายใน (เปลี่ยนเป็นรหัสเฉพาะของระบบ)
ADMIN_BYPASS_KEY="mobex_admin_bypass_2026"

# ------------------------------------------------------------------------------
# 4. DOMAINS, CORS & URL ROUTING
# ------------------------------------------------------------------------------
# URL หน้าบ้านสำหรับสร้างลิงก์ Reset Password ทางอีเมล
FRONTEND_URL="https://market.autocentric.net"
WEB_ORIGIN="https://market.autocentric.net"

# โดเมนที่อนุญาตให้เรียกใช้งาน API (คั่นด้วยจุลภาค)
CORS_ALLOWED_ORIGINS="https://market.autocentric.net,http://market.autocentric.net,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173"

# ------------------------------------------------------------------------------
# 5. EMAIL DELIVERY (SMTP) & OTP SETTINGS
# ------------------------------------------------------------------------------
# หากไม่ใส่ SMTP ระบบจะใช้โหมดจำลอง (Simulator) ใน Console
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="noreply@autocentric.net"
SMTP_PASS="your_app_specific_password_here"
SMTP_FROM="MOBEX Auto Parts <noreply@autocentric.net>"

# อายุของรหัส OTP และลิงก์รีเซ็ตรหัสผ่าน (นาที)
OTP_TTL_MINUTES=5

# ------------------------------------------------------------------------------
# 6. PAYMENT & LOGISTICS WEBHOOK SECRETS
# ------------------------------------------------------------------------------
# เลขประจำตัวผู้เสียภาษี / PromptPay Biller ID 13 หลัก
PROMPTPAY_BILLER_ID="0105558099881"

# Webhook Secret Keys สำหรับตรวจสอบลายเซ็น HMAC ดิจิทัลจากผู้ให้บริการ (ป้องกันการปลอมสลิป/webhook)
PROMPTPAY_WEBHOOK_SECRET="promptpay-webhook-hmac-sha256-signing-secret"
FLASH_EXPRESS_WEBHOOK_SECRET="flash-express-hmac-sha256-secret-key"
KERRY_EXPRESS_WEBHOOK_SECRET="kerry-express-hmac-sha256-secret-key"

# ------------------------------------------------------------------------------
# 7. RATE LIMITING & DDoS DEFENSE
# ------------------------------------------------------------------------------
# จำกัดคำขอทั่วไป (Global Rate Limit)
RATE_LIMIT_MAX=1000
RATE_LIMIT_TIME_WINDOW="1 minute"

# ป้องกัน Brute Force สำหรับเส้นทาง Auth (Login / Register / OTP)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_TIME_WINDOW="1 minute"

# ------------------------------------------------------------------------------
# 8. MONITORING & DIAGNOSTICS
# ------------------------------------------------------------------------------
# เปิด/ปิดหน้าต่าง Swagger API Docs (/docs) ใน Production (ค่าแนะนำ: false)
ENABLE_SWAGGER=false
