# Database Connection URL (PostgreSQL 16)
# Local development default:
DATABASE_URL="postgresql://ibookky@localhost:5432/car_parts_catalog?schema=public"
TEST_DATABASE_URL="postgresql://ibookky@localhost:5432/car_parts_catalog_test?schema=public"

# Docker Compose PostgreSQL Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=car_parts_catalog
POSTGRES_PORT=5432

# Application Environment
NODE_ENV=development
PORT=3000
