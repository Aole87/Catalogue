// ==============================================================================
// Prisma Schema — Intelligent Automotive E-Commerce & Business Platform
// Database: PostgreSQL 16
// ==============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, pg_trgm, unaccent]
}

// ==============================================================================
// ENUMS
// ==============================================================================

enum CustomerType {
  CUSTOMER
  GARAGE
  SHOP
}

enum PriceTier {
  GENERAL
  GARAGE
  SHOP
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  PLUG_IN_HYBRID
  ELECTRIC
  LPG
  CNG
}

enum FitmentStatus {
  COMPATIBLE
  INCOMPATIBLE
  REQUIRES_VERIFICATION
}

enum ProductReferenceType {
  OEM
  AFTERMARKET
  SUPPLIER
  CROSS_REFERENCE
}

enum ReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
  CANCELLED
}

enum InventoryMovementType {
  PURCHASE_RECEIPT
  SALE
  RESERVATION
  RELEASE
  ADJUSTMENT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
  DAMAGE
  DEDUCTION
  LOSS
  CORRECTION
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAYMENT_CONFIRMED
  PROCESSING
  READY_FOR_SHIPMENT
  SHIPPED
  DELIVERED
  RETURN_REQUESTED
  RETURNED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ShipmentStatus {
  PENDING
  READY_TO_FULFILL
  PICKED
  PACKED
  PACKING
  READY_TO_SHIP
  HANDED_OVER
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
  FAILED
  CANCELLED
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  CANCELLED
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  ADJUST
  EXPIRE
  REFUND_REVERSAL
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum CustomerActivityType {
  ACCOUNT_CREATED
  PROFILE_UPDATED
  VEHICLE_ADDED
  PRODUCT_VIEWED
  SEARCHED
  ADDED_TO_CART
  CHECKOUT_STARTED
  ORDER_CREATED
  ORDER_PAID
  ORDER_SHIPPED
  ORDER_DELIVERED
  COUPON_REDEEMED
  LOYALTY_EARNED
  LOYALTY_REDEEMED
}

// ==============================================================================
// 1. IDENTITY & ACCESS CONTROL DOMAIN
// ==============================================================================

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique
  phone           String?
  passwordHash    String    @map("password_hash")
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  displayName     String?   @map("display_name")
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  // Relations
  roles                       UserRole[]
  customerProfile             CustomerProfile?
  sessions                    Session[]
  auditLogs                   AuditLog[]
  statusChanges               OrderStatusHistory[]
  carts                       Cart[]
  verifiedSlips               PaymentSlip[]
  paymentEvents               PaymentEvent[]
  shippingEvents              ShippingEvent[]
  performedStockMovements     StockMovement[]
  createdPurchaseOrders       PurchaseOrder[]      @relation("POCreatedByUser")
  approvedPurchaseOrders      PurchaseOrder[]      @relation("POApprovedByUser")
  rejectedPurchaseOrders      PurchaseOrder[]      @relation("PORejectedByUser")
  sentPurchaseOrders          PurchaseOrder[]      @relation("POSentByUser")
  cancelledPurchaseOrders     PurchaseOrder[]      @relation("POCancelledByUser")
  receivedGoodsReceipts       GoodsReceipt[]
  customerActivities          CustomerActivity[]
  adjustedLoyaltyTransactions LoyaltyTransaction[] @relation("LoyaltyAdjustedByUser")

  @@map("users")
}

model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model UserRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ==============================================================================
// 2. CUSTOMER DOMAIN
// ==============================================================================

model CustomerProfile {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?      @unique @map("user_id") @db.Uuid
  customerType CustomerType @default(CUSTOMER) @map("customer_type")
  companyName  String?      @map("company_name")
  taxId        String?      @map("tax_id")
  phone        String?
  notes        String?
  isVerified   Boolean      @default(false) @map("is_verified")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")

  // Relations
  user               User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  addresses          CustomerAddress[]
  orders             Order[]
  tagAssignments     CustomerTagAssignment[]
  segmentMemberships CustomerSegmentMembership[]
  activities         CustomerActivity[]
  loyaltyAccount     LoyaltyAccount?
  couponRedemptions  CouponRedemption[]
  campaignAudiences  CampaignAudience[]
  campaignEvents     CampaignEvent[]

  @@map("customer_profiles")
}

model CustomerAddress {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  label         String // e.g., "Home", "Workshop / Garage", "Office"
  recipientName String   @map("recipient_name")
  phone         String
  addressLine1  String   @map("address_line_1")
  addressLine2  String?  @map("address_line_2")
  subdistrict   String // ตำบล / แขวง
  district      String // อำเภอ / เขต
  province      String // จังหวัด
  postalCode    String   @map("postal_code")
  country       String   @default("TH")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

// ==============================================================================
// 3. VEHICLE DOMAIN
// ==============================================================================

model VehicleMake {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String   @unique
  slug            String   @unique
  countryOfOrigin String?  @map("country_of_origin")
  logoUrl         String?  @map("logo_url")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  models VehicleModel[]

  @@map("vehicle_makes")
}

model VehicleModel {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  makeId    String   @map("make_id") @db.Uuid
  name      String
  slug      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  make        VehicleMake         @relation(fields: [makeId], references: [id], onDelete: Cascade)
  generations VehicleGeneration[]

  @@unique([makeId, slug])
  @@index([makeId])
  @@map("vehicle_models")
}

model VehicleGeneration {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modelId   String   @map("model_id") @db.Uuid
  name      String // e.g., "Civic FC", "Hilux Revo AN120", "Mazda 2 DJ"
  code      String? // Internal factory chassis code e.g., "FC1", "FK7"
  startYear Int      @map("start_year")
  endYear   Int?     @map("end_year")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  model    VehicleModel     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  variants VehicleVariant[]

  @@unique([modelId, name])
  @@index([modelId])
  @@map("vehicle_generations")
}

model VehicleEngine {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  engineCode     String?  @map("engine_code") // e.g. "L15BG", "1GD-FTV", "4JJ1-TCX"
  name           String // e.g. "1.5 VTEC Turbo", "2.8 D-4D", "1.9 Ddi BluePower"
  displacementCc Int?     @map("displacement_cc")
  cylinders      Int?
  fuelType       FuelType @default(PETROL) @map("fuel_type")
  aspiration     String? // e.g., "Turbocharged", "Naturally Aspirated"
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  variants VehicleVariant[]

  @@map("vehicle_engines")
}

model VehicleVariant {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  generationId String   @map("generation_id") @db.Uuid
  engineId     String?  @map("engine_id") @db.Uuid
  name         String // e.g. "1.5 Turbo RS", "2.8 GR Sport 4WD", "1.3 SkyActiv-G"
  transmission String? // e.g. "CVT", "6AT", "6MT"
  bodyType     String?  @map("body_type") // e.g. "Sedan", "Hatchback", "Pickup Double Cab"
  drivetrain   String? // e.g. "FWD", "RWD", "4WD", "AWD"
  startYear    Int?     @map("start_year")
  endYear      Int?     @map("end_year")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  generation VehicleGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  engine     VehicleEngine?    @relation(fields: [engineId], references: [id], onDelete: SetNull)
  fitments   ProductFitment[]
  cartItems  CartItem[]

  @@unique([generationId, name])
  @@index([generationId])
  @@index([engineId])
  @@map("vehicle_variants")
}

model ProductFitment {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId        String        @map("product_id") @db.Uuid
  vehicleVariantId String        @map("vehicle_variant_id") @db.Uuid
  position         String        @default("ALL") // e.g., "Front", "Rear", "Front Left", "Rear Axle", "ALL"
  notes            String?
  fitmentStatus    FitmentStatus @default(COMPATIBLE) @map("fitment_status")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  // Relations
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicleVariant VehicleVariant @relation(fields: [vehicleVariantId], references: [id], onDelete: Cascade)

  @@unique([productId, vehicleVariantId, position])
  @@index([productId])
  @@index([vehicleVariantId])
  @@map("product_fitments")
}

// ==============================================================================
// 4. PRODUCT CATALOG DOMAIN
// ==============================================================================

model Category {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId    String?   @map("parent_id") @db.Uuid
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?   @map("image_url")
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  parent              Category?           @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children            Category[]          @relation("CategoryHierarchy")
  products            Product[]
  promotionCategories PromotionCategory[]

  @@map("categories")
}

model Brand {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @unique
  slug        String    @unique
  description String?
  logoUrl     String?   @map("logo_url")
  websiteUrl  String?   @map("website_url")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  products        Product[]
  crossReferences ProductCrossReference[]
  promotionBrands PromotionBrand[]

  @@map("brands")
}

model Product {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku              String    @unique
  slug             String    @unique
  name             String
  shortDescription String?   @map("short_description")
  description      String?
  brandId          String    @map("brand_id") @db.Uuid
  categoryId       String    @map("category_id") @db.Uuid
  barcode          String?
  warrantyText     String?   @map("warranty_text")
  weightGrams      Int?      @map("weight_grams")
  lengthMm         Int?      @map("length_mm")
  widthMm          Int?      @map("width_mm")
  heightMm         Int?      @map("height_mm")
  isActive         Boolean   @default(true) @map("is_active")
  isPublished      Boolean   @default(true) @map("is_published")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  // Relations
  brand              Brand                   @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category           Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  prices             ProductPrice[]
  crossReferences    ProductCrossReference[]
  images             ProductImage[]
  attributeValues    ProductAttributeValue[]
  fitments           ProductFitment[]
  inventoryItems     InventoryItem[]
  stockMovements     StockMovement[]
  stockReservations  StockReservation[]
  orderItems         OrderItem[]
  cartItems          CartItem[]
  supplierProducts   SupplierProduct[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  promotionProducts  PromotionProduct[]

  @@index([brandId])
  @@index([categoryId])
  @@index([isActive, isPublished])
  @@map("products")
}

model ProductPrice {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  tier           PriceTier
  price          Decimal   @db.Decimal(12, 2)
  compareAtPrice Decimal?  @map("compare_at_price") @db.Decimal(12, 2)
  costPrice      Decimal?  @map("cost_price") @db.Decimal(12, 2)
  currency       String    @default("THB")
  validFrom      DateTime? @map("valid_from")
  validTo        DateTime? @map("valid_to")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, tier])
  @@index([productId])
  @@map("product_prices")
}

model ProductCrossReference {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId       String               @map("product_id") @db.Uuid
  referenceType   ProductReferenceType @default(OEM) @map("reference_type")
  referenceNumber String               @map("reference_number")
  brandId         String?              @map("brand_id") @db.Uuid
  notes           String?
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@unique([productId, referenceType, referenceNumber])
  @@index([referenceNumber])
  @@index([productId])
  @@map("product_cross_references")
}

model ProductImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String
  altText   String?  @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductAttribute {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique // e.g., "Viscosity", "Voltage", "Material", "Brake Pad Position"
  code      String   @unique // e.g., "viscosity", "voltage", "material", "pad_position"
  unit      String? // e.g., "W", "V", "mm", "L", "Ah"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  values ProductAttributeValue[]

  @@map("product_attributes")
}

model ProductAttributeValue {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  attributeId String   @map("attribute_id") @db.Uuid
  value       String // e.g., "5W-30", "12V", "Ceramic", "Front Axle"
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId])
  @@index([productId])
  @@index([attributeId])
  @@map("product_attribute_values")
}

// ==============================================================================
// 5. INVENTORY & WAREHOUSE OPERATIONS DOMAIN (PHASE M10)
// ==============================================================================

model Warehouse {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String    @unique // e.g., "WH-MAIN", "WH-BKK-01"
  name         String
  description  String?
  addressLine1 String?   @map("address_line_1")
  district     String?
  province     String?
  postalCode   String?   @map("postal_code")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // Relations
  locations         WarehouseLocation[]
  inventoryItems    InventoryItem[]
  stockMovements    StockMovement[]
  stockReservations StockReservation[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]

  @@map("warehouses")
}

model WarehouseLocation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseId String    @map("warehouse_id") @db.Uuid
  code        String // e.g. "LOC-A01-01"
  name        String
  zone        String? // e.g. "A"
  rack        String? // e.g. "01"
  shelf       String? // e.g. "01"
  bin         String? // e.g. "01"
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  warehouse         Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  inventoryItems    InventoryItem[]
  stockMovements    StockMovement[]
  stockReservations StockReservation[]
  goodsReceipts     GoodsReceipt[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@map("warehouse_locations")
}

model InventoryItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseId     String   @map("warehouse_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  locationId      String?  @map("location_id") @db.Uuid
  onHand          Int      @default(0) @map("on_hand")
  reserved        Int      @default(0)
  safetyStock     Int      @default(5) @map("safety_stock")
  reorderPoint    Int?     @default(10) @map("reorder_point")
  reorderQuantity Int?     @default(20) @map("reorder_quantity")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  location  WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([warehouseId, productId])
  @@index([productId])
  @@index([warehouseId])
  @@index([locationId])
  @@map("inventory_items")
}

model StockReservation {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String?           @map("order_id") @db.Uuid
  productId     String            @map("product_id") @db.Uuid
  warehouseId   String            @map("warehouse_id") @db.Uuid
  locationId    String?           @map("location_id") @db.Uuid
  quantity      Int
  status        ReservationStatus @default(ACTIVE)
  referenceType String?           @map("reference_type") // e.g. "ORDER", "CART", "MANUAL"
  referenceId   String?           @map("reference_id")
  notes         String?
  expiresAt     DateTime?         @map("expires_at")
  committedAt   DateTime?         @map("committed_at")
  releasedAt    DateTime?         @map("released_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  // Relations
  order     Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  product   Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location  WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([warehouseId])
  @@index([orderId])
  @@index([status, expiresAt])
  @@index([referenceType, referenceId])
  @@map("stock_reservations")
}

model StockMovement {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseId       String                @map("warehouse_id") @db.Uuid
  productId         String                @map("product_id") @db.Uuid
  locationId        String?               @map("location_id") @db.Uuid
  movementType      InventoryMovementType @map("movement_type")
  quantity          Int
  beforeOnHand      Int?                  @map("before_on_hand")
  afterOnHand       Int?                  @map("after_on_hand")
  beforeReserved    Int?                  @map("before_reserved")
  afterReserved     Int?                  @map("after_reserved")
  referenceType     String?               @map("reference_type") // e.g. "ORDER", "PURCHASE_RECEIPT", "ADJUSTMENT", "TRANSFER"
  referenceId       String?               @map("reference_id")
  performedByUserId String?               @map("performed_by_user_id") @db.Uuid
  notes             String?
  createdAt         DateTime              @default(now()) @map("created_at")

  // Relations
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product         Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  location        WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  performedByUser User?              @relation(fields: [performedByUserId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([warehouseId])
  @@index([movementType])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("stock_movements")
}

// ==============================================================================
