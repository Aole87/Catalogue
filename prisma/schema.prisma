  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==============================================================================
// 10. SUPPLIER & PROCUREMENT DOMAIN (PHASE M11)
// ==============================================================================

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  CLOSED
}

model Supplier {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String    @unique // e.g., "SUP-BOSCH-01", "SUP-DENSO-TH"
  name         String
  displayName  String?   @map("display_name")
  taxId        String?   @map("tax_id")
  contactName  String?   @map("contact_name")
  email        String?
  phone        String?
  addressLine1 String?   @map("address_line_1")
  addressLine2 String?   @map("address_line_2")
  subdistrict  String?
  district     String?
  province     String?
  postalCode   String?   @map("postal_code")
  country      String    @default("TH")
  paymentTerms String?   @map("payment_terms") // e.g., "NET30", "NET60", "COD", "ADVANCE"
  currency     String    @default("THB")
  leadTimeDays Int?      @default(7) @map("lead_time_days")
  isActive     Boolean   @default(true) @map("is_active")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // Relations
  supplierProducts SupplierProduct[]
  purchaseOrders   PurchaseOrder[]

  @@index([code])
  @@index([name])
  @@index([isActive])
  @@map("suppliers")
}

model SupplierProduct {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId   String    @map("supplier_id") @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  supplierSku  String?   @map("supplier_sku")
  purchaseCost Decimal   @map("purchase_cost") @db.Decimal(12, 2)
  currency     String    @default("THB")
  moq          Int       @default(1) // Minimum Order Quantity
  packSize     Int       @default(1) @map("pack_size")
  leadTimeDays Int?      @map("lead_time_days")
  isPreferred  Boolean   @default(false) @map("is_preferred")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // Relations
  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  poItems  PurchaseOrderItem[]

  @@unique([supplierId, productId])
  @@index([supplierId])
  @@index([productId])
  @@index([isActive])
  @@map("supplier_products")
}

model PurchaseOrder {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  poNumber               String              @unique @map("po_number") // e.g., "PO-20260910-00001"
  supplierId             String              @map("supplier_id") @db.Uuid
  destinationWarehouseId String              @map("destination_warehouse_id") @db.Uuid
  status                 PurchaseOrderStatus @default(DRAFT)
  currency               String              @default("THB")
  subtotal               Decimal             @default(0.00) @db.Decimal(12, 2)
  discountTotal          Decimal             @default(0.00) @map("discount_total") @db.Decimal(12, 2)
  taxTotal               Decimal             @default(0.00) @map("tax_total") @db.Decimal(12, 2)
  shippingCost           Decimal             @default(0.00) @map("shipping_cost") @db.Decimal(12, 2)
  otherCost              Decimal             @default(0.00) @map("other_cost") @db.Decimal(12, 2)
  grandTotal             Decimal             @default(0.00) @map("grand_total") @db.Decimal(12, 2)
  notes                  String?
  termsAndConditions     String?             @map("terms_and_conditions")
  expectedDeliveryDate   DateTime?           @map("expected_delivery_date")
  createdByUserId        String?             @map("created_by_user_id") @db.Uuid
  approvedByUserId       String?             @map("approved_by_user_id") @db.Uuid
  approvedAt             DateTime?           @map("approved_at")
  rejectedByUserId       String?             @map("rejected_by_user_id") @db.Uuid
  rejectedAt             DateTime?           @map("rejected_at")
  rejectionReason        String?             @map("rejection_reason")
  sentByUserId           String?             @map("sent_by_user_id") @db.Uuid
  sentAt                 DateTime?           @map("sent_at")
  cancelledByUserId      String?             @map("cancelled_by_user_id") @db.Uuid
  cancelledAt            DateTime?           @map("cancelled_at")
  cancellationReason     String?             @map("cancellation_reason")
  closedAt               DateTime?           @map("closed_at")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  // Relations
  supplier             Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  destinationWarehouse Warehouse           @relation(fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  createdByUser        User?               @relation("POCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvedByUser       User?               @relation("POApprovedByUser", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  rejectedByUser       User?               @relation("PORejectedByUser", fields: [rejectedByUserId], references: [id], onDelete: SetNull)
  sentByUser           User?               @relation("POSentByUser", fields: [sentByUserId], references: [id], onDelete: SetNull)
  cancelledByUser      User?               @relation("POCancelledByUser", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  items                PurchaseOrderItem[]
  goodsReceipts        GoodsReceipt[]

  @@index([supplierId])
  @@index([destinationWarehouseId])
  @@index([status])
  @@index([poNumber])
  @@index([createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseOrderId   String   @map("purchase_order_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  supplierProductId String?  @map("supplier_product_id") @db.Uuid
  productSku        String   @map("product_sku") // Snapshot
  productName       String   @map("product_name") // Snapshot
  supplierSku       String?  @map("supplier_sku") // Snapshot
  unitCost          Decimal  @map("unit_cost") @db.Decimal(12, 2)
  orderedQuantity   Int      @map("ordered_quantity")
  receivedQuantity  Int      @default(0) @map("received_quantity")
  discount          Decimal  @default(0.00) @db.Decimal(12, 2)
  tax               Decimal  @default(0.00) @db.Decimal(12, 2)
  lineTotal         Decimal  @map("line_total") @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplierProduct SupplierProduct?   @relation(fields: [supplierProductId], references: [id], onDelete: SetNull)
  receiptItems    GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptNumber    String   @unique @map("receipt_number") // e.g., "GRN-20260910-00001"
  purchaseOrderId  String   @map("purchase_order_id") @db.Uuid
  warehouseId      String   @map("warehouse_id") @db.Uuid
  locationId       String?  @map("location_id") @db.Uuid
  idempotencyKey   String?  @unique @map("idempotency_key")
  status           String   @default("COMPLETED") // "COMPLETED", "CANCELLED"
  receivedAt       DateTime @default(now()) @map("received_at")
  receivedByUserId String?  @map("received_by_user_id") @db.Uuid
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  purchaseOrder  PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  warehouse      Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location       WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  receivedByUser User?              @relation(fields: [receivedByUserId], references: [id], onDelete: SetNull)
  items          GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([warehouseId])
  @@index([receiptNumber])
  @@index([receivedAt])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  goodsReceiptId      String   @map("goods_receipt_id") @db.Uuid
  purchaseOrderItemId String   @map("purchase_order_item_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  receivedQuantity    Int      @map("received_quantity")
  acceptedQuantity    Int      @map("accepted_quantity")
  rejectedQuantity    Int      @default(0) @map("rejected_quantity")
  supplierSku         String?  @map("supplier_sku") // Snapshot
  unitCost            Decimal  @map("unit_cost") @db.Decimal(12, 2)
  rejectionReason     String?  @map("rejection_reason")
  createdAt           DateTime @default(now()) @map("created_at")

  // Relations
  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
  @@index([productId])
  @@map("goods_receipt_items")
}

// ==============================================================================
// 11. CUSTOMER CRM DOMAIN (PHASE M12)
// ==============================================================================

model CustomerTag {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  color       String   @default("#3B82F6")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  assignments CustomerTagAssignment[]

  @@map("customer_tags")
}

model CustomerTagAssignment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  tagId      String   @map("tag_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      CustomerTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([customerId, tagId])
  @@index([customerId])
  @@index([tagId])
  @@map("customer_tag_assignments")
}

model CustomerSegment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  code        String    @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  isAutomatic Boolean   @default(true) @map("is_automatic")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  rules       CustomerSegmentRule[]
  memberships CustomerSegmentMembership[]
  campaigns   MarketingCampaign[]

  @@index([code])
  @@index([isActive])
  @@map("customer_segments")
}

model CustomerSegmentRule {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  segmentId String   @map("segment_id") @db.Uuid
  field     String // e.g., "order_count", "lifetime_value", "days_since_last_order", "customer_type"
  operator  String // e.g., "EQUALS", "GREATER_THAN_OR_EQUAL", "LESS_THAN_OR_EQUAL", "GREATER_THAN", "LESS_THAN"
  value     String // Value as string e.g., "3", "10000", "90", "GARAGE"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  segment CustomerSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@index([segmentId])
  @@map("customer_segment_rules")
}

model CustomerSegmentMembership {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  segmentId  String   @map("segment_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  // Relations
  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  segment  CustomerSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@unique([customerId, segmentId])
  @@index([customerId])
  @@index([segmentId])
  @@map("customer_segment_memberships")
}

model CustomerActivity {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String?              @map("customer_id") @db.Uuid
  userId      String?              @map("user_id") @db.Uuid
  eventType   CustomerActivityType @map("event_type")
  description String
  metadata    Json?
  ipAddress   String?              @map("ip_address")
  userAgent   String?              @map("user_agent")
  createdAt   DateTime             @default(now()) @map("created_at")

  // Relations
  customer CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@map("customer_activities")
}

// ==============================================================================
// 12. PROMOTION & COUPON DOMAIN (PHASE M12)
// ==============================================================================

model Promotion {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  code                  String?
  description           String?
  promotionType         PromotionType   @default(PERCENTAGE) @map("promotion_type")
  status                PromotionStatus @default(DRAFT)
  startsAt              DateTime?       @map("starts_at")
  endsAt                DateTime?       @map("ends_at")
  priority              Int             @default(0)
  stackable             Boolean         @default(false)
  minimumOrderAmount    Decimal         @default(0.00) @map("minimum_order_amount") @db.Decimal(12, 2)
  discountValue         Decimal         @map("discount_value") @db.Decimal(12, 2)
  maximumDiscountAmount Decimal?        @map("maximum_discount_amount") @db.Decimal(12, 2)
  usageLimit            Int?            @map("usage_limit")
  usageCount            Int             @default(0) @map("usage_count")
  perCustomerLimit      Int?            @map("per_customer_limit")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  deletedAt             DateTime?       @map("deleted_at")

  // Relations
  rules       PromotionRule[]
  products    PromotionProduct[]
  categories  PromotionCategory[]
  brands      PromotionBrand[]
  coupons     Coupon[]
  redemptions CouponRedemption[]
  orders      Order[]

  @@index([status])
  @@index([startsAt, endsAt])
  @@map("promotions")
}

model PromotionRule {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promotionId String   @map("promotion_id") @db.Uuid
  ruleType    String   @map("rule_type") // e.g. "MIN_ITEMS", "CUSTOMER_TIER", "FIRST_ORDER"
  ruleValue   Json?    @map("rule_value")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@map("promotion_rules")
}

model PromotionProduct {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promotionId String   @map("promotion_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
  @@index([promotionId])
  @@index([productId])
  @@map("promotion_products")
}

model PromotionCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promotionId String   @map("promotion_id") @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([promotionId, categoryId])
  @@index([promotionId])
  @@index([categoryId])
  @@map("promotion_categories")
}

model PromotionBrand {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promotionId String   @map("promotion_id") @db.Uuid
  brandId     String   @map("brand_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([promotionId, brandId])
  @@index([promotionId])
  @@index([brandId])
  @@map("promotion_brands")
}

model Coupon {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String    @unique
  promotionId      String    @map("promotion_id") @db.Uuid
  usageLimit       Int?      @map("usage_limit")
  usageCount       Int       @default(0) @map("usage_count")
  perCustomerLimit Int?      @map("per_customer_limit")
  startsAt         DateTime? @map("starts_at")
  endsAt           DateTime? @map("ends_at")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  // Relations
  promotion   Promotion          @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  redemptions CouponRedemption[]

  @@index([code])
  @@index([promotionId])
  @@index([isActive])
  @@map("coupons")
}

model CouponRedemption {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  couponId       String   @map("coupon_id") @db.Uuid
  promotionId    String?  @map("promotion_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  customerId     String?  @map("customer_id") @db.Uuid
  discountAmount Decimal  @map("discount_amount") @db.Decimal(12, 2)
  redeemedAt     DateTime @default(now()) @map("redeemed_at")

  // Relations
  coupon    Coupon           @relation(fields: [couponId], references: [id], onDelete: Cascade)
  promotion Promotion?       @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer  CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([couponId, orderId])
  @@index([couponId])
  @@index([orderId])
  @@index([customerId])
  @@map("coupon_redemptions")
}

// ==============================================================================
// 13. LOYALTY FOUNDATION DOMAIN (PHASE M12)
// ==============================================================================

model LoyaltyAccount {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId       String   @unique @map("customer_id") @db.Uuid
  pointsBalance    Int      @default(0) @map("points_balance")
  lifetimeEarned   Int      @default(0) @map("lifetime_earned")
  lifetimeRedeemed Int      @default(0) @map("lifetime_redeemed")
  tier             String   @default("BRONZE")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  customer     CustomerProfile      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  @@index([customerId])
  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId       String                 @map("account_id") @db.Uuid
  orderId         String?                @map("order_id") @db.Uuid
  transactionType LoyaltyTransactionType @map("transaction_type")
  points          Int // positive for EARN/ADJUST, negative for REDEEM/REFUND_REVERSAL
  balanceAfter    Int                    @map("balance_after")
  reason          String?
  referenceId     String?                @map("reference_id")
  createdByUserId String?                @map("created_by_user_id") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at")

  // Relations
  account       LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  order         Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdByUser User?          @relation("LoyaltyAdjustedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([orderId])
  @@index([transactionType])
  @@index([createdAt])
  @@map("loyalty_transactions")
}

// ==============================================================================
// 14. MARKETING CAMPAIGN DOMAIN (PHASE M12)
// ==============================================================================

model MarketingCampaign {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  code                String         @unique
  description         String?
  status              CampaignStatus @default(DRAFT)
  segmentId           String?        @map("segment_id") @db.Uuid
  startsAt            DateTime?      @map("starts_at")
  endsAt              DateTime?      @map("ends_at")
  budget              Decimal?       @db.Decimal(12, 2)
  targetAudienceCount Int            @default(0) @map("target_audience_count")
  engagedCount        Int            @default(0) @map("engaged_count")
  convertedCount      Int            @default(0) @map("converted_count")
  totalRevenue        Decimal        @default(0.00) @map("total_revenue") @db.Decimal(12, 2)
  discountCost        Decimal        @default(0.00) @map("discount_cost") @db.Decimal(12, 2)
  metadata            Json?
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  deletedAt           DateTime?      @map("deleted_at")

  // Relations
  segment   CustomerSegment?   @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  audiences CampaignAudience[]
  events    CampaignEvent[]

  @@index([code])
  @@index([status])
  @@map("marketing_campaigns")
}

model CampaignAudience {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId       String    @map("campaign_id") @db.Uuid
  customerId       String    @map("customer_id") @db.Uuid
  isEngaged        Boolean   @default(false) @map("is_engaged")
  isConverted      Boolean   @default(false) @map("is_converted")
  convertedOrderId String?   @map("converted_order_id") @db.Uuid
  convertedAt      DateTime? @map("converted_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  // Relations
  campaign       MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer       CustomerProfile   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  convertedOrder Order?            @relation("OrderCampaignConversion", fields: [convertedOrderId], references: [id], onDelete: SetNull)

  @@unique([campaignId, customerId])
  @@index([campaignId])
  @@index([customerId])
  @@map("campaign_audiences")
}

model CampaignEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  customerId String?  @map("customer_id") @db.Uuid
  eventType  String   @map("event_type") // e.g. "VIEW", "CLICK", "DISMISS", "CONVERT"
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer CustomerProfile?  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([customerId])
  @@index([eventType])
  @@map("campaign_events")
}

// ==============================================================================
// 14. ARTICLES & SYSTEM SETTINGS DOMAIN
// ==============================================================================

model Article {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titleTh     String   @map("title_th")
  titleEn     String   @map("title_en")
  slug        String   @unique
  contentTh   String   @map("content_th")
  contentEn   String   @map("content_en")
  coverImage  String?  @map("cover_image")
  category    String   @default("General")
  published   Boolean  @default(true)
  author      String   @default("Admin")
  views       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("articles")
}

model SystemSetting {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique
  value     Json
  category  String   @default("GENERAL") // PAYMENT, SHIPPING, MENU, GENERAL
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

