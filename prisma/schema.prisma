  @@unique([cartId, productId, vehicleVariantId])
  @@index([cartId])
  @@index([productId])
  @@index([vehicleVariantId])
  @@map("cart_items")
}

// ==============================================================================
// 6. ORDER FOUNDATION DOMAIN
// ==============================================================================

model Order {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber           String      @unique @map("order_number")
  customerId            String?     @map("customer_id") @db.Uuid
  status                OrderStatus @default(PENDING_PAYMENT)
  currency              String      @default("THB")
  subtotal              Decimal     @db.Decimal(12, 2)
  discountTotal         Decimal     @default(0.00) @map("discount_total") @db.Decimal(12, 2)
  shippingTotal         Decimal     @default(0.00) @map("shipping_total") @db.Decimal(12, 2)
  taxTotal              Decimal     @default(0.00) @map("tax_total") @db.Decimal(12, 2)
  grandTotal            Decimal     @map("grand_total") @db.Decimal(12, 2)
  promotionId           String?     @map("promotion_id") @db.Uuid
  couponCode            String?     @map("coupon_code")
  loyaltyPointsRedeemed Int         @default(0) @map("loyalty_points_redeemed")
  loyaltyPointsEarned   Int         @default(0) @map("loyalty_points_earned")
  promotionSnapshot     Json?       @map("promotion_snapshot")
  customerNotes         String?     @map("customer_notes")
  adminNotes            String?     @map("admin_notes")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  // Relations
  customer               CustomerProfile?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  promotion              Promotion?           @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  items                  OrderItem[]
  statusHistory          OrderStatusHistory[]
  payments               Payment[]
  shipments              Shipment[]
  stockReservations      StockReservation[]
  couponRedemptions      CouponRedemption[]
  loyaltyTransactions    LoyaltyTransaction[]
  campaignAudienceOrders CampaignAudience[]   @relation("OrderCampaignConversion")

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  productId       String?  @map("product_id") @db.Uuid
  sku             String
  productName     String   @map("product_name")
  unitPrice       Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity        Int
  discountTotal   Decimal  @default(0.00) @map("discount_total") @db.Decimal(12, 2)
  taxTotal        Decimal  @default(0.00) @map("tax_total") @db.Decimal(12, 2)
  lineTotal       Decimal  @map("line_total") @db.Decimal(12, 2)
  productSnapshot Json?    @map("product_snapshot")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String       @map("order_id") @db.Uuid
  fromStatus      OrderStatus? @map("from_status")
  toStatus        OrderStatus  @map("to_status")
  note            String?
  changedByUserId String?      @map("changed_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")

  // Relations
  order         Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser User? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_status_histories")
}

// ==============================================================================
// 7. PAYMENT FOUNDATION DOMAIN (PHASE M7)
// ==============================================================================

model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  internalReference String        @unique @default(dbgenerated("gen_random_uuid()")) @map("internal_reference")
  idempotencyKey    String?       @unique @map("idempotency_key")
  provider          String // e.g. "PROMPTPAY", "BANK_TRANSFER", "STRIPE", "OMISE", "COD", "TEST"
  method            String // e.g. "QR", "SLIP_UPLOAD", "CREDIT_CARD", "CASH"
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("THB")
  providerReference String?       @map("provider_reference")
  metadata          Json?
  paidAt            DateTime?     @map("paid_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  // Relations
  order        Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events       PaymentEvent[]
  transactions PaymentTransaction[]
  refunds      PaymentRefund[]
  slips        PaymentSlip[]

  @@index([orderId])
  @@index([status])
  @@index([internalReference])
  @@index([providerReference])
  @@map("payments")
}

model PaymentEvent {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId  String         @map("payment_id") @db.Uuid
  eventType  String         @map("event_type") // e.g. "PAYMENT_CREATED", "STATUS_CHANGED", "WEBHOOK_PROCESSED", "SLIP_SUBMITTED", "REFUND_PROCESSED"
  fromStatus PaymentStatus? @map("from_status")
  toStatus   PaymentStatus  @map("to_status")
  reason     String?
  payload    Json?
  actorId    String?        @map("actor_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at")

  // Relations
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([eventType])
  @@index([createdAt])
  @@map("payment_events")
}

model PaymentTransaction {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId             String   @map("payment_id") @db.Uuid
  transactionType       String   @map("transaction_type") // e.g. "CHARGE", "AUTHORIZE", "CAPTURE", "REFUND"
  amount                Decimal  @db.Decimal(12, 2)
  currency              String   @default("THB")
  status                String // e.g. "SUCCESS", "PENDING", "FAILED"
  providerTransactionId String?  @map("provider_transaction_id")
  gatewayResponse       Json?    @map("gateway_response")
  createdAt             DateTime @default(now()) @map("created_at")

  // Relations
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([providerTransactionId])
  @@map("payment_transactions")
}

model PaymentRefund {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId       String   @map("payment_id") @db.Uuid
  refundReference String   @unique @map("refund_reference")
  amount          Decimal  @db.Decimal(12, 2)
  currency        String   @default("THB")
  reason          String
  status          String   @default("COMPLETED") // "PENDING", "COMPLETED", "FAILED"
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_refunds")
}

model WebhookEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    String // e.g. "PROMPTPAY", "OMISE", "STRIPE", "TEST"
  eventId     String    @map("event_id") // Provider's unique event ID
  eventType   String    @map("event_type")
  payload     Json
  status      String    @default("RECEIVED") // "RECEIVED", "PROCESSED", "FAILED", "DUPLICATE"
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@index([provider])
  @@index([status])
  @@map("webhook_events")
}

model PaymentSlip {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId        String    @map("payment_id") @db.Uuid
  slipUrl          String    @map("slip_url")
  bankName         String?   @map("bank_name")
  transferAmount   Decimal?  @map("transfer_amount") @db.Decimal(12, 2)
  transferredAt    DateTime? @map("transferred_at")
  notes            String?
  status           String    @default("PENDING_REVIEW") // "PENDING_REVIEW", "VERIFIED", "REJECTED"
  verifiedByUserId String?   @map("verified_by_user_id") @db.Uuid
  verifiedAt       DateTime? @map("verified_at")
  rejectionReason  String?   @map("rejection_reason")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  payment        Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  verifiedByUser User?   @relation(fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([status])
  @@map("payment_slips")
}

// ==============================================================================
// 8. SHIPPING FOUNDATION DOMAIN (PHASE M8)
// ==============================================================================

model ShippingMethod {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String   @unique // e.g. "KERRY", "FLASH", "SCG", "STANDARD", "TEST"
  name             String
  description      String?
  carrier          String? // e.g. "FLASH", "KERRY", "SCG", "STANDARD", "TEST"
  basePrice        Decimal  @default(0.00) @map("base_price") @db.Decimal(12, 2)
  estimatedMinDays Int      @default(1) @map("estimated_min_days")
  estimatedMaxDays Int      @default(3) @map("estimated_max_days")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  shipments Shipment[]

  @@map("shipping_methods")
}

model Shipment {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipmentNumber    String         @unique @default(dbgenerated("gen_random_uuid()")) @map("shipment_number")
  orderId           String         @map("order_id") @db.Uuid
  shippingMethodId  String?        @map("shipping_method_id") @db.Uuid
  status            ShipmentStatus @default(PENDING)
  trackingNumber    String?        @map("tracking_number")
  carrier           String? // e.g. "Flash Express", "Kerry Express", "Standard Delivery", "Test Courier"
  serviceLevel      String?        @map("service_level") // e.g. "STANDARD", "EXPRESS", "NEXT_DAY"
  shippingCost      Decimal        @default(0.00) @map("shipping_cost") @db.Decimal(12, 2)
  currency          String         @default("THB")
  recipientName     String?        @map("recipient_name")
  phone             String?
  addressLine1      String?        @map("address_line_1")
  addressLine2      String?        @map("address_line_2")
  subdistrict       String?
  district          String?
  province          String?
  postalCode        String?        @map("postal_code")
  country           String         @default("TH")
  addressSnapshot   Json?          @map("address_snapshot")
  estimatedDelivery DateTime?      @map("estimated_delivery")
  shippedAt         DateTime?      @map("shipped_at")
  deliveredAt       DateTime?      @map("delivered_at")
  metadata          Json?
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  // Relations
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shippingMethod ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  events         ShippingEvent[]

  @@index([orderId])
  @@index([status])
  @@index([shipmentNumber])
  @@index([trackingNumber])
  @@map("shipments")
}

model ShippingEvent {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipmentId      String         @map("shipment_id") @db.Uuid
  status          ShipmentStatus
  description     String
  location        String?
  providerEventId String?        @map("provider_event_id")
  actorId         String?        @map("actor_id") @db.Uuid
  occurredAt      DateTime       @default(now()) @map("occurred_at")
  receivedAt      DateTime       @default(now()) @map("received_at")
  metadata        Json?

  // Relations
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([status])
  @@index([occurredAt])
  @@map("shipping_events")
}

model ShippingWebhookEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    String // e.g. "FLASH", "KERRY", "TEST"
  eventId     String    @map("event_id") // Provider's unique event ID
  eventType   String    @map("event_type")
  payload     Json
  status      String    @default("RECEIVED") // "RECEIVED", "PROCESSED", "FAILED", "DUPLICATE"
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@index([provider])
  @@index([status])
  @@map("shipping_webhook_events")
}

// ==============================================================================
// 9. AUDIT LOG FOUNDATION DOMAIN
// ==============================================================================

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String // e.g., "CREATE", "UPDATE", "DELETE", "LOGIN", "PRICE_UPDATE"
  resource   String // e.g., "Product", "ProductPrice", "Order", "User"
  resourceId String?  @map("resource_id")
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
